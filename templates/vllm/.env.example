# Hugging Face model id (instruct checkpoint for /v1/chat/completions)
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_SERVED_NAME=llm

# Host path for weights. Needs tens–hundreds of GB.
VLLM_HF_CACHE=/var/lib/vllm/hf

# Listen. Keep loopback unless a firewall is in front.
VLLM_BIND=127.0.0.1:8000

# Required. Must start with sk-local-
# Generate: openssl rand -hex 24  →  sk-local-<that>
VLLM_API_KEY=sk-local-

# Gated models only. Never commit this file with a real token.
HF_TOKEN=

# Set to 1 only if nvidia-smi works but the vLLM image rejects the host driver.
# VLLM_ENABLE_CUDA_COMPATIBILITY=1
